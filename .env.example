# Скопируйте этот файл в .env и заполните.

# Токен бота (выдаёт @BotFather)
BOT_TOKEN=

# Ключ Claude (console.anthropic.com → API Keys). Пусто — гид отвечает из своей базы знаний.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Прокси для API Claude, если он недоступен напрямую, например http://user:pass@host:port
ANTHROPIC_PROXY=

# Веб-сервер мини-приложения
PORT=8787
# Свой постоянный HTTPS-адрес, если появится. Пусто — временный адрес выдаст Cloudflare Tunnel
PUBLIC_URL=
TUNNEL=cloudflared

# Распознавание речи: tiny / base / small / medium / large-v3-turbo
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
WHISPER_THREADS=8

# Голос: ru-RU-SvetlanaNeural (женский) или ru-RU-DmitryNeural (мужской)
TTS_VOICE=ru-RU-SvetlanaNeural
TTS_RATE=+0%

# Кому можно пользоваться ботом: id Telegram через запятую. Пусто — всем, кто найдёт бота
ALLOWED_USER_IDS=
